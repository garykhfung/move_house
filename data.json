  "hkMoveContextFactors": [
    {
      "factor": "貨梯／升降機預約（service lift booking）",
      "detail": "有管理的大廈一般要求預早預約貨梯及在指定時段搬運，或需繳付按金。長治東區指南：大型屋苑通常需最少一星期前向管理處登記。",
      "sources": [
        "https://bestmovershk.com/local-moving/",
        "https://ccmove.com.hk/%E5%A4%A7%E5%BB%88%E6%90%AC%E5%B1%8B%E8%B3%87%E6%96%99/%E6%9D%B1%E5%8D%80/",
        "https://www.applemoving.com.hk/"
      ]
    },
    {
      "factor": "樓梯搬運附加費",
      "detail": "消委會 2024：逐件計價的公司中，樓梯附加費多為每層（15–20 級）總額 15–20%；有一間公司收 30%。公司例子：蘋果按級數分百分比；實惠每層收搬運費 30%；港昇每件每層 HKD30–100；迅速每件大型傢俬每層 HKD50–200。",
      "sources": [
        "https://www.consumer.org.hk/tc/article/573-home-removal-service/573-home-removal-service-price-comparison",
        "https://www.applemoving.com.hk/en/eng-pricing/",
        "https://www.priceright.com.hk/moving-price-list-hk/",
        "https://www.starexpresshk.com/moving-pricing",
        "https://speedy-move.com/moving/"
      ]
    },
    {
      "factor": "泊車／推路／平台轉𨋢",
      "detail": "半山／山頂鄰近地段路窄、上落貨點較遠，會產生推運費。蘋果：≥50 米加 20%、≥200 米加 30%，平台升降機 HKD300。實惠：推運按搬運費百分比計；港島半山窄路說明。港昇：每約 50 米推運 HKD100–300；轉運／限高需評估。東亞網上報價包樓梯／平台（複雜村路除外）；隧道及泊車另計。",
      "sources": [
        "https://www.applemoving.com.hk/en/eng-pricing/",
        "https://www.priceright.com.hk/moving-price-list-hk/",
        "https://www.starexpresshk.com/moving-pricing",
        "https://eamovers.com.hk/app/indexen/online_quotation",
        "https://ftc.hk/mid-levels-moving-company"
      ]
    },
    {
      "factor": "週末／公眾假期附加費",
      "detail": "蘋果星期日及公眾假期加 20%。實惠星期六、日及公眾假期加 HKD200。東亞週末最低消費 HKD1800，平日 HKD1000。GoGoX 公開收費表列有 Call Van 星期日及公眾假期附加費。消委會指逐件計價組別中，大部分受訪公司不收週末附加費，只有一間加 HKD200。",
      "sources": [
        "https://www.applemoving.com.hk/en/eng-pricing/",
        "https://www.priceright.com.hk/moving-price-list-hk/",
        "https://eamovers.com.hk/app/indexen/online_quotation",
        "https://www.gogox.com/hk/pricing/",
        "https://www.consumer.org.hk/tc/article/573-home-removal-service/573-home-removal-service-price-comparison"
      ]
    },
    {
      "factor": "北角／城市花園相關公開資料",
      "detail": "長治東區專頁列出城市花園，並指北角部分舊樓升降機較細。消委會 2024 年例子：北角五人家庭星期六搬往美孚，20 間公司報價 HKD3,818–12,162（調查價格，並非現時報價）。",
      "sources": [
        "https://ccmove.com.hk/%E5%A4%A7%E5%BB%88%E6%90%AC%E5%B1%8B%E8%B3%87%E6%96%99/%E6%9D%B1%E5%8D%80/",
        "https://www.consumer.org.hk/tc/article/573-home-removal-service/573-home-removal-service-price-comparison"
      ]
    },
    {
      "factor": "Moorsom Road／渣甸山通道",
      "detail": "沒有搬屋公司公開 Moorsom Road 專屬收費。公開地理資料：Moorsom Road 位於渣甸山（鄰近山頂地段），並非中環半山扶手電梯一帶——預計路窄、可能需在較遠位置泊車，並涉及山頂／半山網頁常見的樓梯及推運因素（FTC、Best Movers、迅速半山服務區列表）。",
      "sources": [
        "https://ftc.hk/mid-levels-moving-company",
        "https://bestmovershk.com/local-moving/",
        "https://speedy-move.com/moving/"
      ]
    },
    {
      "factor": "城市花園搬屋登記／管理處要求",
      "detail": "暫時搵唔到城市花園專屬嘅公開搬屋規定。長治搬運嘅城市花園專頁寫明：「搬運時間、按金、升降機保護及貨車停泊安排未有公開資料，搬屋前請向管理處確認。」「最少一星期前登記」只係長治東區指南對大型屋苑嘅一般講法（「大部分大型屋苑都要向管理處登記搬運日期及時間，部分要預約貨梯及繳交按金，建議至少一星期前辦妥」），唔係城市花園專屬規定。地產網站列明管理公司為家利物業管理有限公司；House730 亦提醒「大廈電梯並不達頂層或28樓」。建議最少一星期前致電城市花園管理處，確認登記方法、准許搬運時段、貨梯預約、按金同貨車上落貨位置。",
      "sources": [
        "https://ccmove.com.hk/%E5%A4%A7%E5%BB%88%E6%90%AC%E5%B1%8B%E8%B3%87%E6%96%99/%E5%9F%8E%E5%B8%82%E8%8A%B1%E5%9C%92/",
        "https://ccmove.com.hk/%E5%A4%A7%E5%BB%88%E6%90%AC%E5%B1%8B%E8%B3%87%E6%96%99/%E6%9D%B1%E5%8D%80/",
        "https://hk.centanet.com/estate/%E5%9F%8E%E5%B8%82%E8%8A%B1%E5%9C%92/3-tndtzhtrht",
        "https://www.house730.com/estate-10770/%E5%8C%97%E8%A7%92-%E5%9F%8E%E5%B8%82%E8%8A%B1%E5%9C%92/"
      ],
